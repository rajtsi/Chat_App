generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  displayName  String
  username     String   @unique
  email        String   @unique
  password     String
  avatar       String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sentMessages Message[]            @relation("SenderMessages")
  memberships  ConversationMember[]
}

model Conversation {
  id            String             @id @default(uuid())
  type          ConversationType   // Fixed back to your original Enum type
  name          String?
  createdAt     DateTime           @default(now())
  lastMessageAt DateTime?
  messages      Message[]
  members       ConversationMember[]

  // Optimizes sorting your chat list/inbox by latest message activity
  @@index([lastMessageAt(sort: Desc)])
}

model ConversationMember {
  id             String    @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime  @default(now())
  lastSeenAt     DateTime?

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
}

model Message {
  id             String    @id @default(uuid())
  content        String
  createdAt      DateTime  @default(now())
  senderId       String
  seenAt         DateTime?
  conversationId String

  sender       User         @relation("SenderMessages", fields: [senderId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  // Optimizes fetching historical messages chronologically inside a room
  @@index([conversationId, createdAt(sort: Asc)])
}

enum ConversationType {
  DM
  ROOM
  SELF
}